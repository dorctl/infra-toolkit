# Normalize line endings in the repository
* text=auto

# Windows scripts keep CRLF in the working tree
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.vbs   text eol=crlf

# Unix scripts must stay LF or they break on Linux
*.sh    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf

# Docs and data
*.md    text eol=lf
*.sql   text
*.csv   text
*.json  text
*.xml   text
*.yml   text eol=lf
